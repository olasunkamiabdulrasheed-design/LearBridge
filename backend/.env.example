# Copy to .env and adjust for local development.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origin(s) allowed to call the API (comma-separated).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty for SQLite (default). Example Postgres:
# DATABASE_URL=postgres://learnbridge:learnbridge@localhost:5432/learnbridge
DATABASE_URL=
# --- Stage 3 agent (all optional; empty keys = deterministic local mode) ---
AGENT_ENABLED=True
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=120
AGENT_ALLOW_WEB=False
LEARNBRIDGE_LLM_PROVIDER=none
LEARNBRIDGE_LLM_API_KEY=
LEARNBRIDGE_LLM_BASE_URL=
LEARNBRIDGE_LLM_MODEL=
LEARNBRIDGE_SEARCH_PROVIDER=catalog
TAVILY_API_KEY=
